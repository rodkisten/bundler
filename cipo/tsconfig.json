{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {}
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "./test/**",
    "**/*.test.ts",
    "**/*.bench.ts",
    "./examples/**",
    "./vite.config.ts",
    "./vitest.config.ts",
    "./dist/**"
  ]
}
