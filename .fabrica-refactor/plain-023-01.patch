index 0000000000000000000000000000000000000000..7f11d999054524330c134b5990012b4abdbb9c99
--- /dev/null
+++ b/fabrica/render/template-runtime.ts
@@ -0,0 +1,153 @@
+import {
+  bindTemplateAttribute,
+} from "../bindings/attribute.js";
+import {
+  createAttributeBindingValue,
+} from "../bindings/interpolation.js";
+import { bindEvent } from "../events.js";
+import { bindSpreadPart } from "../bindings/spread.js";
+import { applyComponentParts } from "./component-part.js";
+import { collectCleanupNodes } from "./cleanup.js";
+import {
+  createHtmlResult,
+  getHtmlArtifact,
+  isHtmlResult,
+  pruneInsignificantWhitespace,
+} from "./html-result.js";
+import {
+  getCurrentFabricaRuntime,
+  runWithCurrentFabricaRuntime,
+  runWithFabricaRuntime,
+} from "../core/runtime-context.js";
+import {
+  getCompiledJsxTemplate,
+  getCompiledTemplate,
+  resolvePath,
+} from "../template/index.js";
+import { createChildPart, appendValue } from "./value.js";
+import {
+  FABRICA_HTML_ARTIFACT,
+  type FabricaRuntimeContext,
+  type HtmlArtifact,
+  type HtmlResult,
+  type HtmlTag,
+  type HtmlTemplateTag,
+  type RenderValue,
+  type TemplatePart,
+} from "../types.js";
+
+function createTemplateArtifact(
+  strings: TemplateStringsArray,
+  values: readonly RenderValue[],
+  jsxMode: boolean,
+  runtime: FabricaRuntimeContext,
+): HtmlArtifact {
+  const exposedStrings = Object.freeze(Array.from(strings));
+  const capturedValues = Object.freeze(
+    Array.from(values),
+  ) as readonly RenderValue[];
+
+  return Object.freeze({
+    kind: "fabrica.html" as const,
+    strings: exposedStrings,
+    values: capturedValues,
+    jsx: jsxMode,
+    materialize: () =>
+      runWithFabricaRuntime(runtime, () =>
+        materializeHtmlTemplate(strings, capturedValues, jsxMode, runtime),
+      ),
+  });
+}
+
+/** Materializes one interpreted template using the compiled DOM part plan. */
+export function materializeHtmlTemplate(
+  strings: TemplateStringsArray,
+  values: readonly RenderValue[],
+  jsxMode: boolean,
+  runtime: FabricaRuntimeContext,
+): HtmlResult {
+  const compiled = jsxMode
+    ? getCompiledJsxTemplate(strings, values)
+    : getCompiledTemplate(strings, values);
+  const fragment = compiled.template.content.cloneNode(true) as DocumentFragment;
+
+  let cleanupNodes: Node[] = [];
+  if (compiled.orderedParts.length > 0) {
+    const collected = collectCleanupNodes(() => {
+      applyParts(
+        fragment,
+        compiled.orderedParts,
+        values,
+        compiled.hasComponents,
+      );
+    });
+    cleanupNodes = collected.nodes;
+  }
+
+  pruneInsignificantWhitespace(fragment);
+
+  return createHtmlResult(
+    fragment,
+    createTemplateArtifact(strings, values, jsxMode, runtime),
+    {
+      cleanupNodes,
+      dynamic: compiled.orderedParts.length > 0 || cleanupNodes.length > 0,
+    },
+  );
+}
+
+const htmlTemplateTag: HtmlTemplateTag = (
+  strings: TemplateStringsArray,
+  ...values: RenderValue[]
+): HtmlResult =>
+  runWithCurrentFabricaRuntime(() => {
+    const runtime = getCurrentFabricaRuntime();
+    return materializeHtmlTemplate(strings, values, false, runtime);
+  });
+
+const jsxHtmlTemplateTag: HtmlTemplateTag = (
+  strings: TemplateStringsArray,
+  ...values: RenderValue[]
+): HtmlResult =>
+  runWithCurrentFabricaRuntime(() => {
+    const runtime = getCurrentFabricaRuntime();
+    return materializeHtmlTemplate(strings, values, true, runtime);
+  });
+
+/** Creates DOM from a tagged template and attaches its rematerialization artifact. */
+export const html: HtmlTag = Object.assign(htmlTemplateTag, {
+  jsx: jsxHtmlTemplateTag,
+  artifact: getHtmlArtifact,
+  isResult: isHtmlResult,
+});
+
+/** JSX-friendly namespace for `jsx.html` authoring. */
+export const jsx = Object.freeze({ html: jsxHtmlTemplateTag });
+
+function applyParts(
+  fragment: DocumentFragment,
+  parts: readonly TemplatePart[],
+  values: readonly RenderValue[],
+  hasComponents: boolean,
+): void {
+  let index = 0;
+
+  while (index < parts.length) {
+    const part = parts[index]!;
+
+    if (part.type === "component") {
+      const nextIndex = applyComponentParts(
+        fragment,
+        parts,
+        index,
+        values,
+        appendValue,
+      );
+      if (nextIndex > index) {
+        index = nextIndex;
+        continue;
+      }
+    }
+
+    if (part.type === "componentProp") {
+      index += 1;
+      continue;
+    }
+
+    const node = resolvePath(fragment, part.path);
+    if (!node) {
+      index += 1;
+      continue;
+    }
+
+    if (part.type === "child") {
+      createChildPart(node).set(values[part.index]);
+    } else if (part.type === "attribute") {
+      const element = node instanceof Element ? node : null;
+      if (element) {
+        bindTemplateAttribute(
+          element,
+          part.name,
+          createAttributeBindingValue(part, values),
+        );
+      }
+    } else if (part.type === "property") {
+      const element = node instanceof Element ? node : null;
+      if (element) {
+        bindTemplateAttribute(element, `.${part.name}`, values[part.index]);
+      }
+    } else if (part.type === "booleanAttribute") {
+      const element = node instanceof Element ? node : null;
+      if (element) {
+        bindTemplateAttribute(element, `?${part.name}`, values[part.index]);
+      }
+    } else if (part.type === "event") {
+      bindEvent(node, part.name, values[part.index]);
+    } else if (part.type === "spread") {
+      bindSpreadPart(node, values[part.index]);
+    } else if (part.type === "conditionalClass") {
+      const element = node instanceof Element ? node : null;
+      if (element) {
+        bindTemplateAttribute(
+          element,
+          `class:${part.name}`,
+          values[part.index],
+        );
+      }
+    }
+
+    index += 1;
+  }
+
+  if (!hasComponents) return;
+  const placeholders = fragment.querySelectorAll?.("fabrica-component");
+  if (!placeholders) return;
+  for (const placeholder of placeholders) placeholder.remove();
+}
+
+void FABRICA_HTML_ARTIFACT;
