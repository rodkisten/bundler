diff --git a/fabrica/test/entrypoints.test.ts b/fabrica/test/entrypoints.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69866d87d17d6835c65c188bc59993c3c41df2d9
--- /dev/null
+++ b/fabrica/test/entrypoints.test.ts
@@ -0,0 +1,52 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+afterEach(() => {
+  vi.resetModules();
+  Reflect.deleteProperty(globalThis, "Fabrica");
+});
+
+describe("package entrypoints", () => {
+  it("keeps the root runtime import side-effect free", async () => {
+    const previous = globalThis.Fabrica;
+    Reflect.deleteProperty(globalThis, "Fabrica");
+
+    const runtime = await import("../index.js");
+    expect(runtime.default).toBeDefined();
+    expect(globalThis.Fabrica).toBeUndefined();
+
+    if (previous !== undefined) globalThis.Fabrica = previous;
+  });
+
+  it("installs globals only through the browser entrypoint", async () => {
+    Reflect.deleteProperty(globalThis, "Fabrica");
+    const browser = await import("../browser-entry.js");
+
+    expect(globalThis.Fabrica).toBe(browser.default);
+    browser.default.noConflict();
+  });
+});
