-export function appendValue(
-  parentNode: Node | null,
-  value: RenderValue,
-  beforeNode: Node | null = null,
-): void {
-  if (!parentNode) return;
-
-  if (value == null || value === false || value === true) {
-    return;
-  }
-
-  if (Array.isArray(value)) {
-    const length = value.length;
-    for (let index = 0; index < length; index += 1) appendValue(parentNode, value[index], beforeNode);
-    return;
-  }
-
-  if (isHtmlResult(value) || isDomNode(value)) {
-    transferDelegatedEventRoot(value, parentNode);
-    parentNode.insertBefore(value, beforeNode);
-    return;
-  }
-
-  if (isComponentPayload(value)) {
-    appendValue(parentNode, materializeComponentPayload(value as ComponentPayload) as RenderValue, beforeNode);
-    return;
-  }
-
-  if (isElementPayload(value)) {
-    parentNode.insertBefore(materializeElementPayload(value as ElementPayload, appendValue), beforeNode);
-    return;
-  }
-
-  if (isDomBag(value)) {
-    parentNode.insertBefore(value.el, beforeNode);
-    return;
-  }
-
-  if (isComponentRenderRequest(value)) {
-    parentNode.insertBefore(materializeComponent(value), beforeNode);
-    return;
-  }
