-  const fragment = document.createDocumentFragment();
-  appendValue(fragment, value);
-  return fragment;
-}
-
-function removeRemainingComponentPlaceholders(root: ParentNode): void {
-  const placeholders = root.querySelectorAll?.("fabrica-component");
-  if (!placeholders) return;
-  for (const placeholder of placeholders) placeholder.remove();
