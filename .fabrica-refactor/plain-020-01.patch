-/**
- * Applies compiled template parts to a cloned fragment.
- *
- * @param fragment - Template clone.
- * @param parts - Compiled parts.
- * @param values - Runtime values.
- * @returns void.
- */
-function applyParts(
-  fragment: DocumentFragment,
-  parts: readonly TemplatePart[],
-  values: readonly RenderValue[],
-  hasComponents: boolean,
-): void {
-  let index = 0;
-
-  while (index < parts.length) {
-    const part = parts[index]!;
-
-    if (part.type === "component") {
-      const nextIndex = applyComponentParts(fragment, parts, index, values);
-      if (nextIndex > index) {
-        index = nextIndex;
-        continue;
-      }
-    }
-
-    if (part.type === "componentProp") {
-      index += 1;
-      continue;
-    }
-
-    const node = resolvePath(fragment, part.path);
-    if (!node) {
-      index += 1;
-      continue;
-    }
-
-    if (part.type === "child") {
-      const childPart = createChildPart(node);
-      childPart.set(values[part.index]);
-    } else if (part.type === "attribute") {
-      bindAttributePart(node, part, values);
-    } else if (part.type === "property") {
-      bindPropertyPart(node, part.name, values[part.index]);
-    } else if (part.type === "booleanAttribute") {
-      bindBooleanAttributePart(node, part.name, values[part.index]);
-    } else if (part.type === "event") {
-      bindEvent(node, part.name, values[part.index]);
-    } else if (part.type === "spread") {
-      bindSpreadPart(node, values[part.index]);
-    } else if (part.type === "conditionalClass") {
-      bindConditionalClassPart(node, part.name, values[part.index]);
-    }
-
-    index += 1;
-  }
-
-  if (!hasComponents) return;
-  removeRemainingComponentPlaceholders(fragment);
-}
