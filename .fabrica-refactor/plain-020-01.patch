-
-function createRawHtmlFragment(htmlText: string): DocumentFragment {
-  const cached = rawHtmlTemplateCache.get(htmlText);
-  if (cached) {
-    rawHtmlTemplateCache.delete(htmlText);
-    rawHtmlTemplateCache.set(htmlText, cached);
-    return cached.content.cloneNode(true) as DocumentFragment;
-  }
-
-  const template = document.createElement("template");
-  template.innerHTML = htmlText;
-  rawHtmlTemplateCache.set(htmlText, template);
-
-  if (rawHtmlTemplateCache.size > RAW_HTML_TEMPLATE_CACHE_LIMIT) {
-    const oldest = rawHtmlTemplateCache.keys().next().value as string | undefined;
-    if (oldest !== undefined) rawHtmlTemplateCache.delete(oldest);
