-function bindConditionalClassPart(
-  node: Node,
-  className: string,
-  value: RenderValue | undefined,
-): void {
-  if (!isDomElement(node)) return;
-  let previous: boolean | null = null;
-
-  const update = (): void => {
-    const next = Boolean(readValue(value));
-    if (previous === next) return;
-    previous = next;
-    node.classList.toggle(className, next);
-  };
-
-  if (!hasReactiveValue(value)) {
-    update();
-    return;
-  }
-
-  registerCleanup(
-    node,
-    effect(update, {
-      name: `fabrica.classToggle.${className}`,
-      scheduler: "sync",
