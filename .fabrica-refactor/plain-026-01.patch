+++ b/fabrica/test/mount-preserving-children.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import {
+  html,
+  mountPreservingChildren,
+} from "../index.js";
+
+describe("mountPreservingChildren", () => {
+  it("preserves existing nodes and owns only the appended range", () => {
+    const host = document.createElement("div");
+    const server = document.createElement("span");
+    server.textContent = "server";
+    host.append(server);
+
+    const dispose = mountPreservingChildren(
+      host,
+      html`<button>client</button>`,
+    );
+
+    expect(host.firstElementChild).toBe(server);
+    expect(host.textContent).toContain("server");
+    expect(host.textContent).toContain("client");
+
+    dispose();
+    expect(host.firstElementChild).toBe(server);
+    expect(host.textContent).toBe("server");
+  });
+});
