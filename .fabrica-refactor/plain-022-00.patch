+export function applyComponentParts(
+  fragment: DocumentFragment,
+  parts: readonly TemplatePart[],
+  index: number,
+  values: readonly RenderValue[],
+  appendValue: (
+    parentNode: Node | null,
+    value: RenderValue,
+    beforeNode?: Node | null,
+  ) => void,
+): number {
+  const part = parts[index];
+  if (!part || part.type !== "component") return index;
+
+  const node = resolvePath(fragment, part.path);
+  if (!node) return index;
+
+  const componentElement = node as Element;
+  const staticProps: Record<string, unknown> = {};
+  for (const attribute of part.staticProps) {
+    staticProps[normalizeStaticComponentPropName(attribute.name)] =
+      attribute.value;
+  }
+
+  const runtime = getCurrentFabricaRuntime();
+  const dynamicParts: DynamicComponentPropPart[] = [];
+  let nextIndex = index + 1;
+
+  while (nextIndex < parts.length) {
+    const next = parts[nextIndex];
+    if (
+      next?.type !== "componentProp" ||
+      next.componentIndex !== part.componentIndex
+    ) {
+      break;
+    }
+    dynamicParts.push(next);
+    nextIndex += 1;
+  }
+
+  let needsReactiveProps = false;
+  for (const dynamicPart of dynamicParts) {
+    if (componentPropPartIsReactive(dynamicPart, values)) {
+      needsReactiveProps = true;
+      break;
+    }
+  }
+
+  const buildProps = (): Record<string, unknown> => {
+    const props: Record<string, unknown> = { ...staticProps };
+
+    for (const dynamicPart of dynamicParts) {
+      if (isDynamicComponentSpreadPropPart(dynamicPart)) {
+        mergeComponentSpreadProps(props, values[dynamicPart.index], readValue);
+        continue;
+      }
+
+      const name = normalizeComponentPropName(dynamicPart.name);
+      const value = buildComponentPropValue(
+        dynamicPart,
+        values,
+        name,
+      );
+
+      if (name === "props") {
+        mergeComponentSpreadProps(props, value, readValue);
+      } else if (name === ":data") {
+        mergeComponentDataProps(props, value, readValue);
+      } else {
+        props[name] = value;
+      }
+    }
+
+    return props;
+  };
+
+  const dynamicProps = needsReactiveProps
+    ? computed(
+        buildProps,
+        { name: `fabrica.componentProps.${part.tag}` },
+      )
+    : null;
+
+  const props = needsReactiveProps ? dynamicProps!() : buildProps();
+  if (dynamicProps) {
+    Object.defineProperty(props, "__fabricaDynamicProps", {
+      configurable: false,
+      enumerable: false,
+      value: dynamicProps,
+    });
+  }
+
+  const children = extractComponentChildren(componentElement, runtime);
+  const reference =
+    part.referenceIndex == null ? undefined : values[part.referenceIndex];
+  const resolvedComponent =
+    (typeof reference === "function" ? reference : undefined) ??
+    runtime.registry.resolve(part.tag);
+
+  if (!resolvedComponent) {
+    throw new Error(
+      `[Fabrica] Unknown component <${part.tag}> in runtime ` +
+        `"${runtime.name}". Pass a component reference or register it on ` +
+        "this Fabrica instance.",
+    );
+  }
+
+  const replacement = invokeComponentLike(
+    resolvedComponent,
+    { ...props, children },
+  ) as RenderValue;
+  componentElement.replaceWith(
+    document.createComment("fabrica:component:placeholder"),
+  );
+  const placeholder = resolvePath(fragment, part.path);
+  if (!placeholder) return nextIndex;
+  placeholder.replaceWith(materializeComponentResult(replacement, appendValue));
+
+  return nextIndex;
+}
+
+function componentPropPartIsReactive(
+  part: DynamicComponentPropPart,
+  values: readonly RenderValue[],
+): boolean {
+  if (isDynamicComponentSpreadPropPart(part)) {
+    return hasReactiveValue(values[part.index]);
+  }
+
+  if (part.raw) {
+    const rawValue = values[part.indices[0] ?? -1];
+    const propName = normalizeComponentPropName(part.name);
+    const preserveSignal =
+      part.preserveSignal ||
+      (part.preserveSignalProps?.includes(propName) ?? false);
+    if (preserveSignal && isSignal(rawValue)) return false;
+    return hasReactiveValue(rawValue);
+  }
+
+  for (const valueIndex of part.indices) {
+    if (hasReactiveValue(values[valueIndex])) return true;
+  }
+
+  return false;
+}
+
+function buildComponentPropValue(
+  part: Exclude<DynamicComponentPropPart, { spread: true }>,
+  values: readonly RenderValue[],
+  propName: string,
+): unknown {
+  if (part.raw) {
+    const rawValue = values[part.indices[0] ?? -1];
+    const preserveSignal =
+      part.preserveSignal ||
+      (part.preserveSignalProps?.includes(propName) ?? false);
+    if (preserveSignal && isSignal(rawValue)) return rawValue;
+    return readValue(rawValue);
+  }
+
+  let output = part.strings[0] ?? "";
+
+  for (let index = 0; index < part.indices.length; index += 1) {
+    output += stringifyComponentPropValue(
+      readValue(values[part.indices[index]!]),
+    );
+    output += part.strings[index + 1] ?? "";
+  }
+
+  return output;
+}
+
+function stringifyComponentPropValue(value: unknown): string {
+  if (value == null || value === false) return "";
+  if (value === true) return "true";
+  if (isDomNode(value)) return value.textContent ?? "";
+  return String(value);
+}
+
+function extractComponentChildren(
+  element: Element,
+  runtime: FabricaRuntimeContext,
+): DocumentFragment {
+  const fragment = document.createDocumentFragment();
+  fragment.append(...Array.from(element.childNodes));
+
+  const parts = compileParts(element);
+  if (parts.length > 0) {
+    setDeferredComponentChildren(fragment, {
+      parts,
+      values: [],
+      hasComponents: parts.some((item) => item.type === "component"),
+      runtime,
+    });
+  }
+
+  return fragment;
+}
+
+function materializeComponentResult(
+  value: RenderValue,
+  appendValue: (
+    parentNode: Node | null,
+    value: RenderValue,
+    beforeNode?: Node | null,
+  ) => void,
+): Node {
+  if (isDomNode(value)) return value;
+
+  const fragment = document.createDocumentFragment();
+  appendValue(fragment, value);
+  return fragment;
+}
