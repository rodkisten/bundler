+import { runWithFabricaRuntime } from "../core/runtime-context.js";
+import type {
+  FabricaRuntimeContext,
+  RenderValue,
+  TemplatePart,
+} from "../types.js";
+
+export type DeferredComponentChildren = {
+  readonly parts: readonly TemplatePart[];
+  readonly values: readonly RenderValue[];
+  readonly hasComponents: boolean;
+  readonly runtime: FabricaRuntimeContext;
+};
+
+const deferredComponentChildren = new WeakMap<
+  DocumentFragment,
+  DeferredComponentChildren
+>();
+
+/** Stores a deferred child-part plan on a component children fragment. */
+export function setDeferredComponentChildren(
+  fragment: DocumentFragment,
+  deferred: DeferredComponentChildren,
+): void {
+  deferredComponentChildren.set(fragment, deferred);
+}
+
+/** Activates deferred child bindings before a component children fragment moves. */
+export function activateDeferredComponentChildren(
+  fragment: DocumentFragment,
+  applyParts: (
+    fragment: DocumentFragment,
+    parts: readonly TemplatePart[],
+    values: readonly RenderValue[],
+    hasComponents: boolean,
+  ) => void,
+): void {
+  const deferred = deferredComponentChildren.get(fragment);
+  if (!deferred) return;
+  deferredComponentChildren.delete(fragment);
+
+  runWithFabricaRuntime(deferred.runtime, () => {
+    applyParts(
+      fragment,
+      deferred.parts,
+      deferred.values,
+      deferred.hasComponents,
+    );
+  });
+}
