+/**
+ * Runtime-only inline CSS compiler boundary.
+ *
+ * This entrypoint intentionally excludes source transforms, Vite integration
+ * and TypeScript compiler dependencies so DOM runtimes can consume inline CSS
+ * compilation without pulling build-time code into the application graph.
+ */
+export { compileInlineCss } from "./compiler-runtime-css.js";
