+function createEditAnchors(
+  source: string,
+  generated: string,
+  preCompiled: string,
+  sourceResult: FabricaCompileSourceResult,
+): readonly SourceMapAnchor[] {
+  const anchors: SourceMapAnchor[] = [];
+
+  for (const entry of sourceResult.manifest) {
+    const originalText = source.slice(entry.start, entry.end);
+    if (!originalText) continue;
+    const candidate = readGeneratedTemplateSearchTerm(
+      preCompiled,
+      generated,
+      entry,
+    );
+    if (!candidate) continue;
+    const generatedOffset = generated.indexOf(candidate);
+    if (generatedOffset < 0) continue;
+    anchors.push({
+      generatedOffset,
+      originalOffset: entry.start,
+    });
+  }
+
+  return anchors;
+}
+
+function readGeneratedTemplateSearchTerm(
+  preCompiled: string,
+  generated: string,
+  entry: FabricaCompiledTemplateManifestEntry,
+): string | null {
+  const tagSource = preCompiled.slice(entry.start, entry.end);
+  const literal = tagSource.match(/<([A-Za-z][\w:-]*)/);
+  if (literal) {
+    const quoted = JSON.stringify(literal[1]);
+    if (generated.includes(quoted)) return quoted;
+  }
+
+  if (entry.tag && entry.tag !== "template") {
+    const quoted = JSON.stringify(entry.tag);
+    if (generated.includes(quoted)) return quoted;
+  }
+
+  return generated.includes("createCompiledTemplate")
+    ? "createCompiledTemplate"
+    : null;
+}
