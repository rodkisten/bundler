index 0000000000000000000000000000000000000000..1f423f9abc495a75dc0c4589c48a835b6bfd2285
--- /dev/null
+++ b/fabrica/render/payload.ts
@@ -0,0 +1,183 @@
+import { effect } from "@rodkisten/broto/reactivity";
+import {
+  bindPropertyOrAttributeValue,
+  setPropertyOrAttribute,
+} from "../bindings/property-or-attribute.js";
+import { bindRef } from "../bindings/ref.js";
+import { stringifyAttributeValue } from "../bindings/serialize.js";
+import { bindSpecialAttribute } from "../bindings/special.js";
+import { bindEvent } from "../events.js";
+import { registerCleanup } from "./cleanup.js";
+import { hasReactiveValue, readValue } from "../core/value.js";
+import type {
+  ComponentPayload,
+  ElementPayload,
+  RenderValue,
+} from "../types.js";
+
+/** Callback used by payload materializers to append nested children. */
+export type AppendRenderValue = (
+  parentNode: Node,
+  value: RenderValue,
+  beforeNode?: Node | null,
+) => void;
+
+/** Checks whether a renderer value is an element payload from fabrica-elements. */
+export function isElementPayload(value: unknown): value is ElementPayload {
+  return Boolean(
+    value &&
+    typeof value === "object" &&
+    typeof (value as ElementPayload).tag === "string",
+  );
+}
+
+/** Checks whether a renderer value is a component payload from fabrica-elements. */
+export function isComponentPayload(value: unknown): value is ComponentPayload {
+  return Boolean(
+    value &&
+    typeof value === "object" &&
+    "component" in (value as Record<string, unknown>),
+  );
+}
+
+/** Materializes a tag payload into a live DOM element. */
+export function materializeElementPayload(
+  payload: ElementPayload,
+  appendValue: AppendRenderValue,
+): Element {
+  const element = document.createElement(payload.tag);
+  applyPayloadProps(element, payload.props || {}, appendValue);
+  return element;
+}
+
+type RendererPayloadComponent = ((
+  props?: Record<string, unknown>,
+) => unknown) & {
+  renderPayload?: (props?: Record<string, unknown>) => unknown;
+};
+
+/** Invokes a component while preferring a renderer-owned payload when available. */
+export function invokeComponentLike(
+  componentValue: unknown,
+  props: Record<string, unknown>,
+): unknown {
+  if (typeof componentValue !== "function") return null;
+
+  const component = componentValue as RendererPayloadComponent;
+  return typeof component.renderPayload === "function"
+    ? component.renderPayload(props)
+    : component(props);
+}
+
+/** Materializes a component payload by calling its component function. */
+export function materializeComponentPayload(
+  payload: ComponentPayload,
+): unknown {
+  return invokeComponentLike(payload.component, payload.props || {});
+}
+
+/** Applies renderer payload props through canonical binding primitives. */
+export function applyPayloadProps(
+  element: Element,
+  props: Record<string, unknown>,
+  appendValue: AppendRenderValue,
+): void {
+  for (const key in props) {
+    const propValue = props[key];
+
+    if (key === "children") {
+      appendValue(element, propValue as RenderValue);
+      continue;
+    }
+
+    if (bindSpecialAttribute(element, key, propValue)) continue;
+
+    if (key === "ref") {
+      bindRef(element, propValue);
+      continue;
+    }
+
+    if (key === "on" && propValue && typeof propValue === "object") {
+      for (const [eventName, listener] of Object.entries(
+        propValue as Record<string, unknown>,
+      )) {
+        if (typeof listener === "function") {
+          bindEvent(
+            element,
+            eventName,
+            listener as unknown as RenderValue,
+          );
+        }
+      }
+      continue;
+    }
+
+    if (key.startsWith("on") && typeof propValue === "function") {
+      bindEvent(
+        element,
+        key.slice(2).toLowerCase(),
+        propValue as unknown as RenderValue,
+      );
+      continue;
+    }
+
+    if (key === "class" || key === "className" || key === "style") {
+      bindPayloadValue(element, key, propValue, (resolved) => {
+        const attributeName = key === "className" ? "class" : key;
+        const text = stringifyAttributeValue(attributeName, resolved);
+        if (text) element.setAttribute(attributeName, text);
+        else element.removeAttribute(attributeName);
+      });
+      continue;
+    }
+
+    if (key === "attrs" && propValue && typeof propValue === "object") {
+      for (const [name, value] of Object.entries(
+        propValue as Record<string, unknown>,
+      )) {
+        setPropertyOrAttribute(element, name, readValue(value));
+      }
+      continue;
+    }
+
+    if (
+      key === "dataset" &&
+      propValue &&
+      typeof propValue === "object" &&
+      element instanceof HTMLElement
+    ) {
+      for (const [name, value] of Object.entries(
+        propValue as Record<string, unknown>,
+      )) {
+        const resolved = readValue(value);
+        if (resolved == null) delete element.dataset[name];
+        else element.dataset[name] = String(resolved);
+      }
+      continue;
+    }
+
+    bindPropertyOrAttributeValue(element, key, propValue);
+  }
+}
+
+function bindPayloadValue(
+  element: Element,
+  name: string,
+  value: unknown,
+  apply: (resolved: unknown) => void,
+): void {
+  const update = (): void => apply(readValue(value));
+
+  if (!hasReactiveValue(value)) {
+    update();
+    return;
+  }
+
+  registerCleanup(
+    element,
+    effect(update, {
+      name: `fabrica.payloadProp.${name}`,
+      scheduler: "sync",
+    }),
+  );
+}
