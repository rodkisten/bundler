+/** Stable template-planning facade. */
+export {
+  getCompiledJsxTemplate,
+  getCompiledTemplate,
+} from "./cache.js";
+export {
+  compileParts,
+  finalizeCompiledTemplate,
+} from "./parts.js";
+export {
+  prepareJsxSource,
+  prepareSource,
+} from "./source.js";
+
+/** Resolves one cached child-node path against a cloned template root. */
+export function resolvePath(root: Node, path: readonly number[]): Node | null {
+  let node: Node | null = root;
+  for (let index = 0; node && index < path.length; index += 1) {
+    node = node.childNodes[path[index]!] ?? null;
+  }
+  return node;
+}
