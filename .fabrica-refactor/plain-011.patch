+    if (ts.isImportEqualsDeclaration(statement)) {
+      if (!statement.isTypeOnly) names.add(statement.name.text);
+      continue;
+    }
+
+    if (ts.isFunctionDeclaration(statement)) {
+      if (statement.name) names.add(statement.name.text);
+      continue;
+    }
