{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": [],
    "paths": {},
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "./test/**",
    "**/*.test.ts",
    "**/*.bench.ts",
    "./examples/**",
    "./vite.config.ts",
    "./vitest.config.ts",
    "./dist/**"
  ]
}
